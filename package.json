{
  "name": "pens",
  "version": "1.0.0",
  "description": "Digital notebook for pen tablet",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.pens.app",
    "afterPack": "./afterPack.js",
    "asar": true,
    "files": [
      "**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!.github/**/*",
      "!*.js",
      "main/**/*.js",
      "renderer/**/*",
      "afterPack.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "zod": "^4.6.5"
  }
}
