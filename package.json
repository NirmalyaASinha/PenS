{
  "name": "pens",
  "productName": "PenS",
  "version": "1.0.0-rc.1",
  "description": "Digital notebook & pen tablet browser for Windows",
  "author": "Nirmalya Sinha",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm.cmd run dist",
    "dist": "node scripts/build.js",
    "release:dry": "node scripts/release.js --dry-run",
    "release": "node scripts/release.js --publish"
  },
  "build": {
    "appId": "com.nirmalyasinha.pens",
    "productName": "PenS",
    "copyright": "Copyright © 2026 Nirmalya Sinha",
    "icon": "LOGO.png",
    "afterPack": "./afterPack.js",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!.github/**/*",
      "!*.js",
      "main/**/*.js",
      "renderer/**/*",
      "afterPack.js",
      "node_modules/**/*"
    ],
    "win": {
      "executableName": "PenS",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "legalTrademarks": "PenS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "guid": "E8F3C92B-4A71-4E1D-9B67-94751A2E8B99",
      "shortcutName": "PenS",
      "uninstallDisplayName": "PenS",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "NirmalyaASinha",
      "repo": "PenS"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "zod": "^4.6.5"
  }
}
